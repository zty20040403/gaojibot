{
  "name": "gaoji-desktop",
  "version": "0.1.36",
  "private": true,
  "type": "module",
  "description": "Gaoji independent server deployment and management app",
  "author": "Kenneth",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:runtime": "npm --prefix ../admin-ui run build && node ../packaging/build-runtime.mjs",
    "build:icons": "electron scripts/build-icons.cjs",
    "package:mac": "npm run build:runtime && npm run build:icons && npm run build && electron-builder --mac --arm64",
    "package:win": "npm run build:runtime && npm run build:icons && npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lucide-react": "1.34.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.7.4",
    "ssh2": "1.17.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "com.kenneth.gaoji",
    "productName": "Gaoji",
    "asar": true,
    "npmRebuild": false,
    "publish": {
      "provider": "generic",
      "url": "https://github.com/zty20040403/gaoji-app/releases/latest/download/"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "dist/**",
      "package.json",
      "!node_modules/cpu-features{,/**/*}",
      "!node_modules/ssh2/lib/protocol/crypto/build{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "../packaging/build/deployment",
        "to": "deployment"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Gaoji-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
