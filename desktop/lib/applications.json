{
  "schema": 1,
  "applications": [
    {
      "id": "gaoji",
      "name": "高级机器人",
      "adapter": "gaoji",
      "version": "bundled",
      "systems": ["ubuntu:22.04:x86_64", "ubuntu:24.04:x86_64", "debian:12:x86_64", "debian:13:x86_64", "nixos:*:x86_64"],
      "inputs": ["name", "qq", "models"],
      "dataRoot": "/var/lib/gaoji-app/data/instances",
      "health": ["database", "qq", "model"],
      "minimumFreeBytes": 10737418240,
      "images": "runtime-manifest",
      "access": "ssh-loopback"
    },
    {
      "id": "static-site",
      "name": "静态网站",
      "adapter": "static-site",
      "version": "1",
      "systems": ["ubuntu:22.04:x86_64", "ubuntu:24.04:x86_64"],
      "inputs": ["name", "website-folder"],
      "dataRoot": "/var/lib/gaoji-app/applications",
      "health": ["http-content-sha256"],
      "minimumFreeBytes": 2147483648,
      "images": {
        "web": "docker.io/nginxinc/nginx-unprivileged:stable-alpine@sha256:daa17b944bac2b578e962da4c61ad72a59233b3c63abea17113acaf4e6b9aea4"
      },
      "access": "ssh-loopback"
    }
  ]
}
