---
const items = [
  {
    title: '不存聊天以外的个人信息',
    desc: '只记录理解上下文所需的群聊消息、记忆与后台任务文件；不索取密码或密钥，各群与私聊严格隔离。',
  },
  {
    title: '代码在沙盒里运行，碰不到服务器',
    desc: '每个会话拥有独立隔离的运行环境，AI 执行的命令无法访问宿主机与内网，也不持有平台凭据。',
  },
  {
    title: '敏感话题不碰，群主随时可控',
    desc: '政治、翻墙、色情赌博毒品等话题一律不接；嫌吵可用 /config 关掉主动接话，或用 /stop 暂停。',
  },
];
---

<section class="trust-band" aria-labelledby="trust-heading">
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">隐私与安全</p>
      <h2 id="trust-heading">数据有边界，群主说了算。</h2>
      <p class="intro-link">
        <a href="/privacy/">阅读完整的隐私与安全说明 ›</a>
      </p>
    </div>

    <div class="trust-grid">
      {
        items.map((item) => (
          <a href="/privacy/" class="trust-card">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .trust-band {
    background: var(--gj-bg-alt);
    padding: 5rem 1.25rem;
  }

  .container {
    max-width: 980px;
    margin: 0 auto;
  }

  .section-intro {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--gj-link);
  }

  .section-intro h2 {
    margin: 0 0 0.65rem;
    font-size: clamp(1.75rem, 3.6vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 1.18;
    color: var(--gj-text);
  }

  .intro-link {
    margin: 0;
  }

  .intro-link a {
    font-size: 0.94rem;
    color: var(--gj-link);
    text-decoration: none;
  }

  .intro-link a:hover {
    text-decoration: underline;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .trust-card {
    display: block;
    text-decoration: none;
    background: var(--gj-surface-card);
    border: 1px solid var(--gj-border);
    border-radius: 20px;
    padding: 1.6rem;
    transition: transform 0.2s ease;
  }

  .trust-card:hover {
    transform: translateY(-2px);
  }

  .trust-card h3 {
    margin: 0 0 0.45rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--gj-text);
  }

  .trust-card p {
    margin: 0;
    font-size: 0.87rem;
    line-height: 1.62;
    color: var(--gj-text-secondary);
  }

  @media (max-width: 820px) {
    .trust-band {
      padding: 3.6rem 1.15rem;
    }

    .trust-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
