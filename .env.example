# Host-only configuration. Never copy credentials into a conversation VM.
HOST=127.0.0.1
PORT=8080
AI_STATE_DIR=./data/state
AI_CACHE_DIR=./data/cache
AI_SYSTEM_PROMPT=
# Files win over AI_SYSTEM_PROMPT; keep them on the host, not in this public repo.
# The examples file holds real chat lines ("群友：…" / "你：…") the model imitates.
AI_SYSTEM_PROMPT_FILE=
AI_STYLE_EXAMPLES_FILE=

# PostgreSQL 17 + pgvector. The primary must be writable.
AI_POSTGRES_DSN=postgresql://gaoji:TEST_PASSWORD@127.0.0.1:5432/gaoji
AI_POSTGRES_SCHEMA=qq_bot
AI_POSTGRES_POOL_MIN_SIZE=1
AI_POSTGRES_POOL_MAX_SIZE=24

# Model catalog. Keys reference host environment variables; values stay private.
DEEPSEEK_API_KEY=
AI_MODEL_DEFAULT_PROFILE=deepseek
AI_MODEL_PROFILES_JSON=
AI_SIMPLE_CHAT_PROFILE=
AI_VISION_PROFILE=
AI_STREAM_ENABLED=true

# Official QQ: private credential files, mode 0600.
AI_QQ_OFFICIAL_ENABLED=true
AI_QQ_OFFICIAL_APP_ID_FILE=/run/secrets/qq-app-id
AI_QQ_OFFICIAL_APP_SECRET_FILE=/run/secrets/qq-app-secret
AI_QQ_OFFICIAL_BIND_PEPPER_FILE=/run/secrets/qq-bind-pepper
AI_QQ_OFFICIAL_HOST_CONFIG_FILE=/run/secrets/qq-host.json
AI_QQ_OFFICIAL_SANDBOX=false
AI_QQ_OFFICIAL_OWNER_OPENIDS=[]
AI_QQ_OFFICIAL_PRIVATE_POLICY=owner_only
AI_QQ_OFFICIAL_PRIVATE_ALLOWED_OPENIDS=[]
AI_QQ_OFFICIAL_GROUP_ADMISSION=manual_bind

# Management console signing key and public origin.
AI_ADMIN_SECRET_FILE=/run/secrets/gaoji-admin-key
AI_ADMIN_ORIGIN=https://bot.example.invalid

# Search: scrape or a configured provider such as bocha.
AI_SEARCH_ENABLED=true
AI_SEARCH_PROVIDER=scrape
AI_SEARCH_API_KEY=
AI_SEARCH_MAX_RESULTS=5
AI_SEARCH_TIMEOUT_SECONDS=10

# Persistent conversation VM. Configure the host libvirt runner before enabling.
AI_SANDBOX_ENABLED=false
AI_SANDBOX_BACKEND=vm
AI_SANDBOX_VM_IMAGE=/var/lib/gaoji/images/debian.qcow2
AI_SANDBOX_VM_ROOT=/var/lib/gaoji/vms
AI_SANDBOX_ALLOW_ALL=true
AI_SANDBOX_MAX_TOTAL=8
AI_SANDBOX_MEMORY_MIB=2048
AI_SANDBOX_MAX_FILE_MB=100

# Media library and model used for vision.
AI_MEDIA_ENABLED=true
AI_MEDIA_ROOT=./data/media

# Optional host-only reads for owner-private background jobs.
AI_OPS_READ_BASE_URL=
AI_OPS_READ_TOKEN_FILE=

AI_OBSERVABILITY_ENABLED=true
AI_METRICS_PATH=/metrics
